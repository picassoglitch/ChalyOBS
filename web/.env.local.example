# Copy to .env.local (gitignored). In Vercel, add these under Project →
# Settings → Environment Variables. Naming follows the Chalyb shared convention
# (CHALYB_*, CHALYBCLIP_*, CHALYBCRYPTO_*, CHALYBOBS_*).
#
# ChalyOBS is an agent of Chalyb: users log in at chalyb.com,
# Chalyb mints a 5-min HMAC-signed SSO token, the browser lands on
# /auth/sso?token=... here, which sets our session cookie and bounces to
# /dashboard. There are NO Supabase credentials in ChalyOBS — auth is
# delegated entirely to Chalyb.

# Shared with Chalyb's CHALYBOBS_SSO_SECRET. HMAC-SHA256 over the SSO token.
# Generate with: openssl rand -hex 32. The engine-wide name CHALYB_SSO_SECRET
# (what the other engines read) is accepted as a fallback.
CHALYBOBS_SSO_SECRET=

# Shared with Chalyb's CHALYBOBS_ADMIN_TOKEN. Bearer for /api/admin/* calls
# (POST /api/admin/tenants and /:id/status). Generate with: openssl rand -hex 32.
# The engine-wide name CHALYB_ADMIN_TOKEN is accepted as a fallback.
CHALYBOBS_ADMIN_TOKEN=

# Independent secret — ChalyOBS's own session cookie HMAC. NOT shared.
# Rotating this invalidates every active session. Generate with:
#   openssl rand -hex 32
CHALYBOBS_SESSION_SECRET=

# Absolute public URL of this deploy. Used to build return_to on the
# login redirect to Chalyb.
#   Locally:   http://localhost:3000
#   Cloud Run: not needed — Terraform injects PUBLIC_URL=https://chalybobs.chalyb.com
CHALYBOBS_PUBLIC_URL=http://localhost:3000

# Where to send unauthenticated visitors. Make this a shared (team-level)
# variable in Vercel so every Chalyb engine points at the same login.
CHALYB_LOGIN_URL=https://chalyb.com/login

# ── Per-tenant data store (shared Chalyb Supabase) ──────────────
# ChalyOBS reads/writes its chalybobs_* tables here, scoped by tenant_id.
# Server-side only. Apply migration 0023 in the chalyb repo first.
#
# Same Supabase project as the hub and the other engines, so the SAME
# variables work here: NEXT_PUBLIC_SUPABASE_URL (or SUPABASE_URL) and
# SUPABASE_SERVICE_ROLE_KEY are read as fallbacks. The CHALYBOBS_* names
# below win when set. Either the new-format secret key (sb_secret_..., from
# Supabase → Project Settings → API Keys → Secret keys) or the legacy
# service_role JWT is accepted. Do NOT use the publishable/anon key here.
CHALYBOBS_SUPABASE_URL=https://uqcbziwdgbnzehipzjxp.supabase.co
CHALYBOBS_SUPABASE_SECRET_KEY=

# ── Relay (chalybclip-live MediaMTX) ─────────────────────────────────────
# The reachable RTMP endpoint encoders push to: the relay host's raw TCP
# host:port (NOT an HTTP-only custom domain — RTMP is raw TCP). Example:
#   rtmp://relay.example.com:1935/live
CHALYBOBS_RELAY_RTMP_URL=rtmp://ingest.chalyb.com/live

# Shared bearer the relay presents on /api/internal/live/* — must equal the
# relay service's CHALYBCLIP_INTERNAL_SIGNING_SECRET. This is how the relay
# authorizes a stream key and fetches the tenant's fan-out destinations.
CHALYBOBS_RELAY_SECRET=

# Live preview: the relay's HLS address (MediaMTX hls port). ChalyOBS
# proxies it to the authenticated tenant via /api/preview, so the stream
# key never rides in a browser URL. ChalyOBS runs on Vercel, so this must
# be an address Vercel can reach (no private-network hostnames); keep it
# unlisted / firewalled to ChalyOBS. Unset → preview shows "no disponible".
#   e.g. http://relay.example.com:8888
CHALYBOBS_RELAY_INTERNAL_HLS=

# ── Platform OAuth auto-connect (Restream-style) ───────────────────────
# One click on "Conectar" sends the user to the platform's consent page;
# the callback pulls their channel + stream key and configures the
# destination automatically (no manual key copy/paste). Each platform is
# independent: set only the pairs you have — platforms without credentials
# simply fall back to manual stream-key entry in the dashboard.
#
# Redirect URI to register on EVERY platform (exact match):
#   ${CHALYBOBS_PUBLIC_URL}/api/oauth/<platform>/callback
#
# Kick: kick.com → Settings → Developer → create app.
# Scopes: user:read channel:read channel:write streamkey:read
CHALYBOBS_KICK_CLIENT_ID=
CHALYBOBS_KICK_CLIENT_SECRET=

# Twitch: dev.twitch.tv/console/apps → register app (category: Broadcasting).
# Scopes: channel:read:stream_key channel:manage:broadcast
CHALYBOBS_TWITCH_CLIENT_ID=
CHALYBOBS_TWITCH_CLIENT_SECRET=

# YouTube: console.cloud.google.com → enable "YouTube Data API v3" →
# OAuth consent screen (add test users while unverified) → OAuth client id
# (type: Web application). Scope: https://www.googleapis.com/auth/youtube
CHALYBOBS_YOUTUBE_CLIENT_ID=
CHALYBOBS_YOUTUBE_CLIENT_SECRET=

# ── ChalyClip handoff ("Get Clips") ─────────────────────────────────────
# When a tenant has Get Clips on, ChalyOBS forwards the stream's
# started/ended lifecycle to ChalyClip so the recording runs through
# ChalyClip's auto-clip pipeline.
#   CHALYBCLIP_INTERNAL_URL    base of ChalyClip's internal API
#   CHALYBCLIP_INTERNAL_SECRET bearer == ChalyClip's CHALYBCLIP_INTERNAL_SIGNING_SECRET
#                            (same value shared by relay + ChalyClip + ChalyOBS)
#   CHALYBCLIP_PUBLIC_URL      where the Get Clips button opens
CHALYBCLIP_INTERNAL_URL=https://chalybclip.chalyb.com
CHALYBCLIP_INTERNAL_SECRET=
CHALYBCLIP_PUBLIC_URL=https://chalybclip.chalyb.com
